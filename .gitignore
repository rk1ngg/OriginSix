# Local runtime state and credentials
.local/
**/.local/
**/*.clixml
**/.env
**/.env.*

# Local editor output
**/.vs/
**/.vscode/

# Parent repository's nested Git metadata is kept outside the snapshot.
server/.git/
client/.git/

# Webzen client textures used by the local UI themes stay outside the repository.
client/src/bin/Data/Interface/RmlUi/themes/*/textures/

# Client crash logs
MuError.log
