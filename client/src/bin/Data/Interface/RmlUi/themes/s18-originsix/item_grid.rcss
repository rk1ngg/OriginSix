/* S18 OriginSix item grid using Season 18 cell sprite. */

@spritesheet item-cell-sheet { src: "textures/s18_item_box.tga"; item-cell-art: 0px 0px 21px 21px; }
@spritesheet ig-tl-sheet { src: "../../../newui_item_table01(L).tga"; ig-tl: 0px 0px 14px 14px; }
@spritesheet ig-tr-sheet { src: "../../../newui_item_table01(R).tga"; ig-tr: 0px 0px 14px 14px; }
@spritesheet ig-bl-sheet { src: "../../../newui_item_table02(L).tga"; ig-bl: 0px 0px 14px 14px; }
@spritesheet ig-br-sheet { src: "../../../newui_item_table02(R).tga"; ig-br: 0px 0px 14px 14px; }
@spritesheet ig-t-sheet { src: "../../../newui_item_table03(Up).tga"; ig-t: 0px 0px 1px 14px; }
@spritesheet ig-b-sheet { src: "../../../newui_item_table03(Dw).tga"; ig-b: 0px 0px 1px 14px; }
@spritesheet ig-l-sheet { src: "../../../newui_item_table03(L).tga"; ig-l: 0px 0px 14px 1px; }
@spritesheet ig-r-sheet { src: "../../../newui_item_table03(R).tga"; ig-r: 0px 0px 14px 1px; }

body { --item-cell: 20px; }

.item-grid, .item-grid-counts { position: absolute; pointer-events: none; }
.item-grid-cells, .item-grid-counts { display: flex; flex-wrap: wrap; }
.item-grid-cells { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

.item-cell, .item-count { position: relative; flex: 0 0 var(--item-cell); width: var(--item-cell); height: var(--item-cell); }
.item-cell.tint-normal { background-color: rgba(65, 110, 128, 153); }
.item-cell.tint-durability-50 { background-color: rgba(255, 255, 0, 102); }
.item-cell.tint-durability-70 { background-color: rgba(255, 168, 0, 102); }
.item-cell.tint-durability-80 { background-color: rgba(255, 84, 0, 102); }
.item-cell.tint-durability-100 { background-color: rgba(255, 0, 0, 102); }
.item-cell.tint-untradeable { background-color: rgba(255, 51, 26, 102); }
.item-cell-art { position: absolute; left: 0; top: 0; width: calc(var(--item-cell) + 1px); height: calc(var(--item-cell) + 1px); decorator: image(item-cell-art); }
.item-cell-drop { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.item-cell.drop-free .item-cell-drop { background-color: rgba(26, 102, 204, 102); }
.item-cell.drop-blocked .item-cell-drop, .item-cell.drop-invalid .item-cell-drop { background-color: rgba(255, 51, 51, 102); }
.item-cell.drop-valid .item-cell-drop { background-color: rgba(51, 102, 51, 102); }

.item-grid-frame { position: absolute; left: -4px; top: -3px; right: -5px; bottom: -6px; }
.igf { position: absolute; }
.igf-tl { left: 0; top: 0; width: 14px; height: 14px; decorator: image(ig-tl); }
.igf-tr { right: 0; top: 0; width: 14px; height: 14px; decorator: image(ig-tr); }
.igf-bl { left: 0; bottom: 0; width: 14px; height: 14px; decorator: image(ig-bl); }
.igf-br { right: 0; bottom: 0; width: 14px; height: 14px; decorator: image(ig-br); }
.igf-t { left: 14px; right: 14px; top: 0; height: 14px; decorator: image(ig-t); }
.igf-b { left: 14px; right: 14px; bottom: 0; height: 14px; decorator: image(ig-b); }
.igf-l { left: 0; top: 14px; bottom: 14px; width: 14px; decorator: image(ig-l); }
.igf-r { right: 0; top: 14px; bottom: 14px; width: 14px; decorator: image(ig-r); }

.item-count-text {
	position: absolute;
	right: 0;
	top: 1px;
	transform-origin: right top;
	white-space: nowrap;
	font-weight: bold;
	color: #ffffff;
	font-effect: outline(1px #000000);
}

.item-view { position: absolute; left: -20px; top: -20px; width: 230px; height: 469px; pointer-events: none; }
