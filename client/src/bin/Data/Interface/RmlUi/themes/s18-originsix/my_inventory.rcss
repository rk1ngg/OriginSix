/* S18 OriginSix theme for CMyInventory: Season 18 dark stone & gold frame, crimson demon-crest banner,
   Season 18 equipment slot boxes (including dedicated #slot_guardian), and Season 18 Zen/Ruud bar. */

@spritesheet inv-bg-fill-sheet   { src: "textures/s18_panel_fill.tga";   inv-bg-fill:   0px 0px 190px 429px; }
@spritesheet inv-bg-top-sheet    { src: "textures/s18_panel_top.tga";    inv-bg-top:    0px 0px 190px 64px;  }
@spritesheet inv-bg-left-sheet   { src: "textures/s18_panel_left.tga";   inv-bg-left:   0px 0px 21px 320px;  }
@spritesheet inv-bg-right-sheet  { src: "textures/s18_panel_right.tga";  inv-bg-right:  0px 0px 21px 320px;  }
@spritesheet inv-bg-bottom-sheet { src: "textures/s18_panel_bottom.tga"; inv-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;     top: 0;    width: 190px; height: 429px; decorator: image(inv-bg-fill); }
.bg-top    { left: 0;     top: 0;    width: 190px; height: 64px;  decorator: image(inv-bg-top); }
.bg-left   { left: 0;     top: 64px; width: 21px;  height: 320px; decorator: image(inv-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px;  height: 320px; decorator: image(inv-bg-right); }
.bg-bottom { left: 0;     top: 384px; width: 190px; height: 45px; decorator: image(inv-bg-bottom); }

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

.native-text { white-space: nowrap; pointer-events: none; }

#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	height: 15px;
	cursor: move;
}
.title-text {
	display: block;
	width: 190px;
	text-align: center;
	transform-origin: center top;
	color: #f4d68c;
	font-weight: bold;
}

@spritesheet inv-money-sheet { src: "textures/s18_item_money.tga"; inv-money: 0px 0px 170px 26px; }
#gold_bg {
	position: absolute;
	left: 11px;
	top: 361px;
	width: 170px;
	height: 15px;
	decorator: image(inv-money);
	pointer-events: none;
}
#gold_text {
	position: absolute;
	left: 50px;
	top: 362px;
	transform-origin: left top;
	font-weight: bold;
}

@spritesheet inv-btn-exit-sheet    { src: "../../../newui_exit_00.tga";        inv-btn-exit:    0px 0px 36px 29px; }
@spritesheet inv-btn-repair-sheet  { src: "../../../newui_repair_00.tga";      inv-btn-repair:  0px 0px 36px 29px; }
@spritesheet inv-btn-expand-sheet  { src: "../../../newui_expansion_btn.tga";  inv-btn-expand:  0px 0px 36px 29px; }
@spritesheet inv-btn-myshop-open-sheet  { src: "../../../newui_Bt_openshop.tga";  inv-btn-myshop-open:  0px 0px 36px 29px; }
@spritesheet inv-btn-myshop-close-sheet { src: "../../../newui_Bt_closeshop.tga"; inv-btn-myshop-close: 0px 0px 36px 29px; }

.inv-btn {
	position: absolute;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.inv-btn:hover { filter: brightness(1.25); }
.inv-btn.hidden { display: none; }
.inv-btn.locked { pointer-events: none; filter: brightness(0.6); }

.inv-btn-exit    { left: 13px;  decorator: image(inv-btn-exit); }
.inv-btn-repair  { left: 50px;  decorator: image(inv-btn-repair); }
.inv-btn-myshop  { left: 87px;  decorator: image(inv-btn-myshop-open); }
.inv-btn-myshop.close-mode { decorator: image(inv-btn-myshop-close); }
.inv-btn-expand  { left: 124px; decorator: image(inv-btn-expand); }

.option-labels {
	position: absolute;
	left: 0;
	top: 25px;
	width: 190px;
	text-align: center;
	transform-origin: center top;
	font-weight: bold;
}
.option-label { color: #8c8c8c; }
.option-label.active { color: #ffcc19; }
.option-label + .option-label { margin-left: 0.3em; }

.option-hover {
	position: absolute;
	top: 20px;
	width: 95px;
	height: 15px;
	pointer-events: auto;
	cursor: default;
}
.option-hover-set { left: 0; }
.option-hover-socket { left: 95px; }

@spritesheet inv-slot-helper-sheet       { src: "textures/s18_slot_helper.tga";       inv-slot-helper:       0px 0px 46px 46px; }
@spritesheet inv-slot-helm-sheet         { src: "textures/s18_slot_helm.tga";         inv-slot-helm:         0px 0px 46px 46px; }
@spritesheet inv-slot-wing-sheet         { src: "textures/s18_slot_wing.tga";         inv-slot-wing:         0px 0px 61px 46px; }
@spritesheet inv-slot-weapon-left-sheet  { src: "textures/s18_slot_weapon_left.tga";  inv-slot-weapon-left:  0px 0px 46px 66px; }
@spritesheet inv-slot-armor-sheet        { src: "textures/s18_slot_armor.tga";        inv-slot-armor:        0px 0px 46px 66px; }
@spritesheet inv-slot-weapon-right-sheet { src: "textures/s18_slot_weapon_right.tga"; inv-slot-weapon-right: 0px 0px 46px 66px; }
@spritesheet inv-slot-gloves-sheet       { src: "textures/s18_slot_gloves.tga";       inv-slot-gloves:       0px 0px 46px 46px; }
@spritesheet inv-slot-pants-sheet        { src: "textures/s18_slot_pants.tga";        inv-slot-pants:        0px 0px 46px 46px; }
@spritesheet inv-slot-boots-sheet        { src: "textures/s18_slot_boots.tga";        inv-slot-boots:        0px 0px 46px 46px; }
@spritesheet inv-slot-ring-left-sheet    { src: "textures/s18_slot_ring.tga";         inv-slot-ring-left:    0px 0px 28px 28px; }
@spritesheet inv-slot-amulet-sheet       { src: "textures/s18_slot_amulet.tga";       inv-slot-amulet:       0px 0px 28px 28px; }
@spritesheet inv-slot-ring-right-sheet   { src: "textures/s18_slot_ring.tga";         inv-slot-ring-right:   0px 0px 28px 28px; }
@spritesheet inv-slot-guardian-sheet     { src: "textures/s18_slot_guardian.tga";     inv-slot-guardian:     0px 0px 28px 28px; }

.native-anchor { position: absolute; pointer-events: none; }
#slot_helper       { left: 15px;  top: 44px;  width: 46px; height: 46px; decorator: image(inv-slot-helper); }
#slot_helm         { left: 75px;  top: 44px;  width: 46px; height: 46px; decorator: image(inv-slot-helm); }
#slot_wing         { left: 120px; top: 44px;  width: 61px; height: 46px; decorator: image(inv-slot-wing); }
#slot_weapon_left  { left: 135px; top: 87px;  width: 46px; height: 66px; decorator: image(inv-slot-weapon-left); }
#slot_armor        { left: 75px;  top: 87px;  width: 46px; height: 66px; decorator: image(inv-slot-armor); }
#slot_weapon_right { left: 15px;  top: 87px;  width: 46px; height: 66px; decorator: image(inv-slot-weapon-right); }
#slot_gloves       { left: 15px;  top: 150px; width: 46px; height: 46px; decorator: image(inv-slot-gloves); }
#slot_pants        { left: 75px;  top: 150px; width: 46px; height: 46px; decorator: image(inv-slot-pants); }
#slot_boots        { left: 135px; top: 150px; width: 46px; height: 46px; decorator: image(inv-slot-boots); }
#slot_ring_left    { left: 114px; top: 150px; width: 28px; height: 28px; decorator: image(inv-slot-ring-left); }
#slot_amulet       { left: 54px;  top: 87px;  width: 28px; height: 28px; decorator: image(inv-slot-amulet); }
#slot_ring_right   { left: 54px;  top: 150px; width: 28px; height: 28px; decorator: image(inv-slot-ring-right); }
#slot_guardian     { left: 114px; top: 87px;  width: 28px; height: 28px; decorator: image(inv-slot-guardian); }

.equip-slot.no-art { decorator: none; }
.equip-slot-item { position: absolute; left: 1px; top: 0; right: 3px; bottom: 4px; }
.equip-slot.broken .equip-slot-item, .equip-slot.unequipable .equip-slot-item { background-color: rgba(255, 0, 0, 64); }
.equip-slot.durability-20 .equip-slot-item { background-color: rgba(255, 38, 0, 64); }
.equip-slot.durability-30 .equip-slot-item { background-color: rgba(255, 128, 0, 64); }
.equip-slot.durability-50 .equip-slot-item { background-color: rgba(255, 255, 0, 64); }
.equip-slot.refused .equip-slot-item { background-color: rgba(230, 26, 26, 102); }
#item_grid, #item_grid_counts { left: 15px; top: 200px; width: calc(8 * var(--item-cell)); height: calc(8 * var(--item-cell)); }
#option_tooltip_anchor { left: 95px; top: 40px; }

#panel.slot-placed { pointer-events: none; }

/* S18 extras: Zen and Ruud share the S6 money strip as two 15px rows (the docked panel cannot grow
   past 429px without running under the HUD), plus two reserved earring slots between the
   pendant/guardian row and the ring row. Reserved = drawn but inert until the paired client/server
   slot and Ruud balance exist (docs/GUARDIAN_RUUD_UI_PLAN.md). */
#ruud_bg {
	position: absolute;
	left: 11px;
	top: 376px;
	width: 170px;
	height: 15px;
	decorator: image(inv-money);
	pointer-events: none;
}
#ruud_text {
	position: absolute;
	left: 50px;
	top: 377px;
	transform-origin: left top;
	font-weight: bold;
	color: #d89cff;
}
#slot_earring_left, #slot_earring_right { position: absolute; width: 28px; height: 28px; }
#slot_earring_left  { left: 54px;  top: 118px; decorator: image(inv-slot-ring-left); }
#slot_earring_right { left: 114px; top: 118px; decorator: image(inv-slot-ring-right); }
.equip-slot.slot-reserved { opacity: 0.55; pointer-events: none; }
